# CRM BGH — Variables de entorno
# Copiar a .env y completar los valores

# Base de datos (Railway la provee automáticamente)
DATABASE_URL=sqlite:///crm.db

# Clave secreta para sesiones Flask (cambiar en producción)
SECRET_KEY=cambiar-esta-clave-en-produccion

# ID del Google Spreadsheet
GOOGLE_SHEETS_ID=15RGK3zOJCI6lJVMscp3teQZ_8NRmT7p6

# JSON de credenciales de la Service Account de Google (escapar comillas)
GOOGLE_CREDENTIALS_JSON=

# Token secreto para validar webhooks de Apps Script
WEBHOOK_SECRET=mi-webhook-secreto
